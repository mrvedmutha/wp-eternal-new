{
  "name": "wp-rig/contact-info",
  "apiVersion": 2,
  "title": "Contact Info Panel",
  "category": "widgets",
  "icon": "admin-site-alt3",
  "description": "Editable contact info panel with heading, email, hours, and CTA buttons.",
  "textdomain": "wp-rig",
  "editorScript": "file:./build/index.js",
  "style": "file:./build/style.css",
  "editorStyle": "file:./build/editor.css",
  "render": "file:./render.php",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Contact Us"
    },
    "body": {
      "type": "string",
      "default": "Have a question, need support, or just want to chat about our products? Our team is ready to assist you. Reach out and we'll get back to you as soon as possible."
    },
    "email": {
      "type": "string",
      "default": "customerservice@eternallabs.health"
    },
    "emailHref": {
      "type": "string",
      "default": "mailto:customerservice@eternallabs.health"
    },
    "hours": {
      "type": "string",
      "default": "Mon - Fri, 9:30am - 5:30pm (GMT & EST)"
    },
    "chatLabel": {
      "type": "string",
      "default": "CHAT WITH US"
    },
    "chatUrl": {
      "type": "string",
      "default": "#"
    },
    "appointmentLabel": {
      "type": "string",
      "default": "BOOK APPOINTMENT"
    },
    "appointmentUrl": {
      "type": "string",
      "default": "#"
    }
  },
  "supports": {
    "align": ["full", "wide"],
    "html": false
  }
}
